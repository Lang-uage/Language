# Multi-stage Dockerfile for Langflow Production Deployment
FROM node:20-alpine AS frontend_build

# Build the frontend with custom chat interface
WORKDIR /app/frontend
COPY src/frontend/package*.json ./
RUN npm ci

COPY src/frontend/ ./
RUN npm run build

#########################################
# Stage 2: Python backend with frontend
#########################################
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    LANGFLOW_LOG_ENV=production

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files (excluding frontend since we'll use the built version)
COPY . .
RUN rm -rf src/frontend

# Install Python dependencies using uv
RUN pip install uv && \
    uv pip install --system -e .

# Copy built frontend from previous stage
COPY --from=frontend_build /app/frontend/build /app/frontend/build

# Create necessary directories
RUN mkdir -p /app/flows /app/langflow-config-dir

# Create startup script that uses PORT environment variable
RUN echo '#!/bin/bash \
set -e \
\
# Use PORT environment variable from DigitalOcean (defaults to 8080) \
export PORT=${PORT:-8080} \
\
# Set production environment variables \
export LANGFLOW_AUTO_LOGIN=${LANGFLOW_AUTO_LOGIN:-false} \
export LANGFLOW_SUPERUSER=${LANGFLOW_SUPERUSER:-admin} \
export LANGFLOW_DATABASE_URL=${DATABASE_URL:-sqlite:///./langflow.db} \
export LANGFLOW_SECRET_KEY=${LANGFLOW_SECRET_KEY:-$(openssl rand -base64 32)} \
export LANGFLOW_CACHE_TYPE=${LANGFLOW_CACHE_TYPE:-memory} \
\
echo "Starting Langflow on port $PORT with frontend..." \
langflow run --host 0.0.0.0 --port $PORT --frontend-path /app/frontend/build \
' > /start.sh && chmod +x /start.sh

# Expose the port (DigitalOcean will set the PORT env var)
EXPOSE 8080

# Run the startup script
CMD ["/start.sh"] 