# Langflow Environment Configuration
# Copy this file to .env and modify as needed

# Database Configuration
LANGFLOW_DATABASE_URL=sqlite:///./langflow.db

# Cache Configuration  
LANGFLOW_CACHE_TYPE=memory

# Worker Configuration
LANGFLOW_WORKERS=1
LANGFLOW_WORKER_TIMEOUT=300

# Authentication Configuration
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin123

# Security Configuration
LANGFLOW_SECRET_KEY=langflow-secret-key-change-me-in-production

# Application Configuration
LANGFLOW_CONFIG_DIR=/tmp/langflow

# Logging Configuration
LANGFLOW_LOG_ENV=container

# Port Configuration (for docker-compose)
LANGFLOW_PORT=7860

# Container Name (for scripts)
CONTAINER_NAME=langflow-custom 